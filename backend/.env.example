# ---------------------------------------------------------------------------
# Environment configuration — copy to .env and fill in real values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_TITLE=Resume Intelligence API
APP_VERSION=0.2.0

# ── Security ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./resume_screening.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/resume_db

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── File upload ────────────────────────────────────────────────────────────
# Absolute path to the secure uploads directory (outside web root)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf

# ── ML / Model artifacts ───────────────────────────────────────────────────
# Directory where trained .joblib files are stored
MODEL_DIR=../ml/artifacts
# Filename of the currently deployed model
ACTIVE_MODEL_FILENAME=model_latest.joblib

# ── NLP ────────────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_lg

# ── Email / SMTP ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_ENABLED=false

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_DEFAULT=200/minute

# ── Seed admin (dev only — change in production) ───────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
